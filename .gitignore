# Dependencies
node_modules/

# Build output
build/
dist/
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log

# Environment. example.env is committed and holds no value.
.env
.env.*

# Local MCP client config, which is machine state and points at the drive registry.
.mcp.json

# Editors and the operating system, including the AppleDouble sidecar exFAT writes.
.idea/
.vscode/
*.swp
*~
.DS_Store
._*

# Working documents at the root. Only the readme and the license are ever committed.
/*.md
!/README.md
!/LICENSE.md
!/LICENCE.md
