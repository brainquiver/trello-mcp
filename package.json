{
  "name": "@brainquiver/trello-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol server for Trello, forked and cut down to the tools we use.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "trello"
  ],
  "author": "Brainquiver",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "trello-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write src tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "pretest:smoke": "npm run build",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axios": "^1.13.2",
    "form-data": "^4.0.5",
    "https-proxy-agent": "^9.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^18.0.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "@typescript-eslint/explicit-function-return-type": "off",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "no-console": [
        "error",
        {
          "allow": [
            "error",
            "warn"
          ]
        }
      ]
    },
    "ignorePatterns": [
      "build/",
      "node_modules/",
      "coverage/"
    ]
  }
}
