{
  "name": "@brainquiver/trello-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol server for Trello, forked and cut down to the tools we use.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "trello"
  ],
  "author": "Brainquiver",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "trello-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "pretest:smoke": "npm run build",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.13.2",
    "form-data": "^4.0.5",
    "https-proxy-agent": "^9.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "5.0.2",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "5.0.2"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  }
}
