# Every setting, with no value. The server reads them from the client that starts it, and the
# smoke suite reads them from .env.ci. Git ignores both .env and .env.ci.

# Required. For the key, open https://trello.com/power-ups/admin and create an app that does
# not use Power-Up capabilities. The key is under Authorization, Trello Auth. The server does
# not use the secret on that page. The token comes from
# https://trello.com/1/authorize?expiration=never&name=trello-mcp&scope=read,write&response_type=token&key=<YOUR-API-KEY>
TRELLO_API_KEY=<YOUR-API-KEY>
TRELLO_TOKEN=<YOUR-TOKEN>

# Optional. The board a tool uses when it names none. The id is the first field of the
# board's JSON: open https://trello.com/b/<short link>.json
TRELLO_BOARD_ID=<YOUR-BOARD-ID>

# Optional. Workspace ids, comma separated. When set, the workspace guard refuses anything
# outside them.
TRELLO_ALLOWED_WORKSPACES=

# Optional. The one folder a file:// attachment may come from. Unset, local uploads are refused.
TRELLO_ATTACH_ROOT=

# Optional. The most characters a card description may have. Defaults to 2400, the limit in
# the board-card rules. A longer description is refused before anything reaches Trello.
TRELLO_DESCRIPTION_LIMIT=

# Optional. The largest attachment download_attachment returns, in MB. Defaults to 5. A
# download comes back as base64 in the agent's context, a third larger than the file.
TRELLO_MAX_DOWNLOAD_MB=

# Only for npm run test:smoke. A board the smoke suite may create and archive cards on.
TRELLO_TEST_BOARD_ID=
# Optional, for the smoke tests that need them. A second board in the same workspace, for
# the move test. The workspace of the test boards, and a board in another workspace, for the
# workspace guard tests.
TRELLO_TEST_OTHER_BOARD_ID=
TRELLO_TEST_WORKSPACE_ID=
TRELLO_TEST_REFUSED_WORKSPACE_ID=
TRELLO_TEST_REFUSED_BOARD_ID=
